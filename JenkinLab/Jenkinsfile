// Set Scripts paths to JenkinLab/Jenkinsfile in jenkin job configuration
pipeline {
    agent any // Run this pipeline on any available Jenkins agent/node.

    triggers {
        pollSCM('H/2 * * * *')   // ← check GitHub every 2 minutes
    }
    stages {

        stage('Checkout') {
            steps {
                echo 'Pulling latest code from GitHub...'
                checkout scm // git pull https://github.com/wajid-rah/process_etl.git
            }
        }

        stage('Tear Down Old Containers') {
            steps {
                dir('JenkinLab') {        // ← work inside this subfolder
                //tells every sh command to run from inside that folder, so docker-compose finds the right files.

                    echo 'Stopping any existing containers...'
                    sh 'docker rm -f pg-compose python-compose || true'  // pg-compose from docker-compose.yml
                    sh 'docker-compose down -v || true' //If command fails, pretend it succeeded.
                }
            }
        }

        stage('Build & Run') {
            steps {
                dir('JenkinLab') {        // ← work inside this subfolder
                //tells every sh command to run from inside that folder, so docker-compose finds the right files.

                    echo 'Building image and starting services...'
                    sh 'docker-compose build --no-cache'
                    sh 'docker-compose up --abort-on-container-exit'
                    //Without it Postgres keeps running forever
                    //stops all containers when python-app finishes, so the pipeline doesn't hang.
                }
            }
        }

        stage('Verify Output') {
            steps {
                echo 'Pipeline complete - check logs for employee table'
            }
        }
    }

    post {
        success {
            echo '✅ SUCCESS: PostgreSQL started, data loaded, Python read it!'
            emailext(
                to: 'wjdrahman@gmail.com',
                subject: "✅ Jenkins SUCCESS - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    <h2>Build Succeeded!</h2>
                    <p><b>Job:</b> ${env.JOB_NAME}</p>
                    <p><b>Build:</b> #${env.BUILD_NUMBER}</p>
                    <p><b>Duration:</b> ${currentBuild.durationString}</p>
                    <p><a href="${env.BUILD_URL}">View Build Logs</a></p>
                """,
                mimeType: 'text/html'
            )
        }
        failure {
            echo '❌ FAILURE: Something went wrong. Check logs above.'
            dir('JenkinLab') {
                sh 'docker-compose down -v || true'
            }
            emailext(
                to: 'wjdrahman@gmail.com',
                subject: "❌ Jenkins FAILURE - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    <h2>Build Failed!</h2>
                    <p><b>Job:</b> ${env.JOB_NAME}</p>
                    <p><b>Build:</b> #${env.BUILD_NUMBER}</p>
                    <p><b>Duration:</b> ${currentBuild.durationString}</p>
                    <p><a href="${env.BUILD_URL}console">View Console Output</a></p>
                """,
                mimeType: 'text/html'
            )
        }
        always {
            echo 'Cleaning up containers...'
            dir('JenkinLab') {
                sh 'docker-compose down -v || true'
            }
        }
    }
}